.venv/
__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/
.claude/
data/processed/osmnx_http_cache/
cache/

# Grafos de ruteo (.graphml): con red vial real via pyrosm/peru-latest.osm.pbf
# pesan hasta 384MB por departamento grande (Huancavelica/Madre de Dios) —
# muy por encima del límite de 100MB de GitHub, y el dashboard no los
# necesita (app.py solo lee las matrices matrix_*.parquet, ya committeadas y
# muchísimo más chicas). Se regeneran con `python run_pipeline.py --real`
# a partir del .pbf. El marcador .source (qué fuente se usó) sí se commitea.
data/processed/routing_cache/*/*.graphml

# Tectonic (motor LaTeX autocontenido, ~54MB) descargado localmente para
# compilar el PDF del reporte — no es código del proyecto, se re-descarga
# con el comando documentado en report/README o el Makefile.
.tools/

# Crudos: 149MB, 100% regenerables (python -m src.acquisition --real /
# --synthetic). El issue permite "data/processed/ y data/outputs/ (o script
# regenerador)" en vez de comprometer los crudos — nos quedamos con eso para
# no inflar el repo con archivos descargables de portales oficiales.
data/raw/*
!data/raw/.gitkeep

# basura de compilación LaTeX (el .tex fuente y el .pdf compilado SÍ se commitean)
report/*.aux
report/*.toc
report/*.out
report/*.log
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
